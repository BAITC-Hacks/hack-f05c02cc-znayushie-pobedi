# demo (без внешнего ИИ), openai или nvidia
AI_PROVIDER=demo
OPENAI_API_KEY=
OPENAI_MODEL=
NVIDIA_API_KEY=
NVIDIA_MODEL=
# Разделённые запятой origin фронтенда; не добавляйте завершающий /.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# normalized: 40 записей снимка EKT; demo: 8 синтетических товаров
CATALOG_MODE=normalized

# Фото и сканы: OCR через OpenAI, в том числе при AI_PROVIDER=demo.
# Использует OPENAI_API_KEY и OPENAI_MODEL выше. false отключает передачу файлов.
ATTACHMENT_OCR_ENABLED=true
